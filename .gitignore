# Large model artifacts
checkpoints/

# Python-generated files and local environments
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
venvs/
*.swp

# Local ScienceQA image data (keep source and metadata in Git)
ScienceQA/train/
ScienceQA/val/
ScienceQA/test/
ScienceQA/data/scienceqa/images/

# Chrome/perfetto profiler traces -- 50-430MB each, over GitHub's 100MB limit.
# The derived *_stage_breakdown.txt / *_summary_by_*.txt files are the tracked
# evidence; regenerate raw traces with scripts/profile_ab_trace.py and
# scripts/profile_full_request.py.
results/timing/*_trace.json
results/timing/ab_trace_*.json

# WP2 profiler traces (15-45MB each); the *_summary.txt / *_kernels.txt files are the tracked evidence.
results/timing/wp2_profile/*_trace.json
