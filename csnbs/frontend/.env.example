# Copy to .env.local for local development; this file must never contain real keys.
# npm run dev:live starts the live frontend and a loopback-only gateway.
# Point only at a LOCAL service implementing gateway/README.md's model contract.
# Leave blank to inspect the frontend's unavailable-service state without GPU use.
# LIVE_LOCAL_UPSTREAM_URL=http://127.0.0.1:8000
# LIVE_DEV_PORT=5180
#
# Optional older fixed-setting services (legacy transport; not the new gateway).
# These URLs stay in the Vite server configuration, not in browser assets.
# PLAYGROUND_BASELINE_URL=http://127.0.0.1:8000
# PLAYGROUND_PRUNED_URL=http://127.0.0.1:8001
