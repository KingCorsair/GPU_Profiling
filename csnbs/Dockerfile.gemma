# Optional image. LLaVA keeps its existing system Python dependencies.
ARG BASE_IMAGE=kingcorsair/gpu_profiling_project:latest
FROM ${BASE_IMAGE}

COPY csnbs/requirements-gemma.txt /tmp/requirements-gemma.txt
RUN uv venv --python /usr/bin/python3.12 /opt/gemma && \
    uv pip install --python /opt/gemma/bin/python --no-cache \
        --index-url https://download.pytorch.org/whl/cu126 \
        torch==2.8.0+cu126 torchvision==0.23.0+cu126 && \
    uv pip install --python /opt/gemma/bin/python --no-cache -r /tmp/requirements-gemma.txt && \
    /opt/gemma/bin/python -c "from transformers import AutoProcessor, Gemma3ForConditionalGeneration; import torch; assert torch.version.cuda == '12.6'" && \
    python -c "import torch, transformers; assert torch.__version__.startswith('2.2.2'); assert transformers.__version__ == '4.37.2'"

# The measurement package declares Node >=24 <25. Keep the OS Node separately.
ARG NODE_VERSION=24.13.0
RUN apt-get update && apt-get install -y --no-install-recommends xz-utils ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /opt/node24 && \
    cd /tmp && \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" && \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" && \
    grep " node-v${NODE_VERSION}-linux-x64.tar.xz$" SHASUMS256.txt | sha256sum --check - && \
    tar -xJf "node-v${NODE_VERSION}-linux-x64.tar.xz" -C /opt/node24 --strip-components=1 && \
    rm "node-v${NODE_VERSION}-linux-x64.tar.xz" SHASUMS256.txt
ENV PATH="/opt/node24/bin:${PATH}"
RUN node --version && npm --version
